// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Question {
  id           String         @id @default(cuid())
  statement    String
  alternatives Alternative[]
  exams        ExamQuestion[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Alternative {
  id             String   @id @default(cuid())
  description    String
  shouldBeMarked Boolean
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// identificationMode: "letters" | "powers_of_2"
model Exam {
  id                 String        @id @default(cuid())
  title              String
  course             String        @default("")
  instructor         String        @default("")
  date               String        @default("")
  identificationMode String        @default("letters")
  questions          ExamQuestion[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// Join table that preserves the order the user chose for each question in an exam
model ExamQuestion {
  id         String  @id @default(cuid())
  examId     String
  questionId String
  position   Int
  exam       Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([examId, questionId])
  @@index([examId, position])
}

